# ------------------------------------------------------------------
# ローカル用シークレット定義（テンプレート）
#   1. このファイルを「.env」という名前でコピー
#   2. __XXX__ の部分を実際の値に置き換える
#   3. .env は Git にコミットしない・共有しない（.gitignore 済み）
#
# 実際の値の入手先は 04_シークレット管理.md を参照。
# クラウドのルーティン本文に平文で入っていた値なので、ローカル移行を機に
# 再発行（ローテーション）してから設定することを推奨します。
# ------------------------------------------------------------------

# --- archi-dog 人気商品ランキング（Shopify カスタムアプリ 2種） ---
SHOPIFY_SHOP=gddege-tx.myshopify.com
SHOPIFY_POPULAR_COLLECTION_ID=458932125908
SHOPIFY_READ_ORDERS_CLIENT_ID=__SHOPIFY_READ_ORDERS_CLIENT_ID__
SHOPIFY_READ_ORDERS_CLIENT_SECRET=__SHOPIFY_READ_ORDERS_CLIENT_SECRET__
SHOPIFY_WRITE_CLIENT_ID=__SHOPIFY_WRITE_CLIENT_ID__
SHOPIFY_WRITE_CLIENT_SECRET=__SHOPIFY_WRITE_CLIENT_SECRET__

# --- SEO自動パイプライン（flumo-api-server.com 管理API） ---
# "Authorization: Basic <この値>" の <この値> 部分（base64 エンコード済み文字列）
FLUMO_API_BASIC_AUTH=__FLUMO_API_BASIC_AUTH__

# --- 週次トレンド配信の Slack 配布先（未設定ならプレースホルダのままで可 → 本人DMに送信） ---
AI_TREND_SLACK_CHANNEL_ID=__AI_CHANNEL_ID__
SEO_TREND_SLACK_CHANNEL_ID=__SEO_CHANNEL_ID__
